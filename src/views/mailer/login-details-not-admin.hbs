    {{> mailHeader }}
      <div class="email-body">
        <p >Hi {{user}},</p>
        <p>
        We noticed a login to your account at {{Date/Time}}
        </p>
        <p>
        If this was you, no action is needed. If you didn’t log in, please secure your account immediately:
        </p>
        {{{logerDetails}}}
        <p>
        For any questions, feel free to contact our support team.
        </p>
        <p>Thanks you,</p>
        <p>The {{appName}} Team</p>
      </div>
{{> mailFooter }}
