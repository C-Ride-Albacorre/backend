generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                    String             @id @default(uuid())
  email                 String?            @unique
  phoneNumber           String?            @unique
  password              String?
  firstName             String
  lastName              String
  role                  Role               @default(CUSTOMER)
  isActive              Boolean            @default(true)
  refreshTokenHash      String?
  referralCode          String?            @unique
  referredBy            String?
  lastLoginAt           DateTime?
  isVerified            Boolean            @default(false)
  verifiedAt            DateTime?
  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @updatedAt
  emailVerifiedAt       DateTime?
  isEmailVerified       Boolean            @default(false)
  isPhoneVerified       Boolean            @default(false)
  onboardingCompletedAt DateTime?
  phoneVerifiedAt       DateTime?
  status                UserStatus         @default(ACTIVE)
  profilePicture        String?
  onboardingStatus      OnBoardingStatus   @default(NOT_STARTED)
  onboardingStep        Int?
  approvedAt            DateTime?
  approvedBy            String?
  rejectionReason       String?
  isNewUser             Boolean            @default(false)
  countryCode           String?
  fcmToken              String?
  deviceType            String?
  businessInfo          BusinessInfo?
  cart                  Cart?
  customerLocations     CustomerLocation[]
  driverProfile         DriverProfile?
  oauthProviders        OAuthProvider[]
  orders                Order[]
  stores                Store[]
  documents             VendorDocument[]
  notifications         Notification[]

  @@index([email])
  @@index([phoneNumber])
}

model VerificationAttempt {
  id            String    @id @default(uuid())
  identifier    String    @unique
  otp           String?
  otpIdentifier String?   @unique
  attemptCount  Int       @default(0)
  lastAttemptAt DateTime  @default(now())
  isLocked      Boolean   @default(false)
  lockedUntil   DateTime?
  expiresAt     DateTime
  verified      Boolean   @default(false)
  purpose       String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([otp])
  @@index([purpose])
  @@index([expiresAt])
}

model OAuthProvider {
  id          String            @id @default(uuid())
  provider    OAuthProviderType
  providerId  String
  userId      String
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  profileData Json?
  user        User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerId])
  @@unique([userId, provider])
  @@index([provider, providerId])
}

model BusinessInfo {
  id                 String   @id @default(uuid())
  businessName       String?
  businessType       String?
  description        String?
  businessPhone      String?
  businessEmail      String?
  address            String?
  city               String?
  state              String?
  userId             String   @unique
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  accountName        String?
  accountNumber      String?
  bankName           String?
  registrationNumber String?
  taxId              String?
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VendorDocument {
  id           String         @id @default(uuid())
  userId       String
  documentUrl  String
  status       DocumentStatus @default(PENDING)
  metadata     Json?
  uploadedAt   DateTime       @default(now())
  reviewedAt   DateTime?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  documentType DocumentType   @default(CAC)
  user         User           @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Store {
  id               String          @id @default(uuid())
  storeName        String
  storeDescription String?
  storeAddress     String
  phoneNumber      String
  email            String
  preparationTime  Int?
  deliveryFee      Float?
  storeLogo        String?
  status           StoreStatus     @default(PENDING_APPROVAL)
  userId           String
  metadata         Json?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  approvedAt       DateTime?
  approvedBy       String?
  rejectionReason  String?
  categoryId       String
  latitude         Float?
  longitude        Float?
  dailyOrderLimit  Int?
  operatingHours   OperatingHour[]
  orderItems       OrderItem[]
  packages         Package[]
  products         Product[]
  category         Category        @relation(fields: [categoryId], references: [id])
  user             User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([categoryId])
}

model OperatingHour {
  id          String    @id @default(uuid())
  storeId     String
  dayOfWeek   DayOfWeek
  isOpen      Boolean   @default(true)
  openingTime String?
  closingTime String?
  breakStart  String?
  breakEnd    String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  store       Store     @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@unique([storeId, dayOfWeek])
  @@index([storeId])
}

model Product {
  id                String         @id @default(uuid())
  productName       String
  sku               String         @unique
  description       String?
  productType       ProductType    @default(SINGLE)
  stockStatus       StockStatus    @default(IN_STOCK)
  productStatus     ProductStatus  @default(DRAFT)
  basePrice         Float?
  stockQuantity     Int?           @default(0)
  lowStockThreshold Int?           @default(5)
  storeId           String
  metadata          Json?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
  subcategoryId     String
  addons            Addon[]
  cartItems         CartItem[]
  orderItems        OrderItem[]
  store             Store          @relation(fields: [storeId], references: [id], onDelete: Cascade)
  subcategory       Subcategory    @relation(fields: [subcategoryId], references: [id], onDelete: Cascade)
  productImages     ProductImage[]
  variants          Variant[]

  @@index([storeId])
  @@index([subcategoryId])
  @@index([sku])
}

model ProductImage {
  id           String   @id @default(uuid())
  productId    String
  imageUrl     String
  isPrimary    Boolean  @default(false)
  displayOrder Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  product      Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
}

model Variant {
  id            String      @id @default(uuid())
  variantName   String
  price         Float
  sku           String      @unique
  stockQuantity Int         @default(0)
  stockStatus   StockStatus @default(IN_STOCK)
  imageUrl      String?
  productId     String
  attributes    Json?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  cartItems     CartItem[]
  orderItems    OrderItem[]
  product       Product     @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@index([sku])
}

model Addon {
  id          String   @id @default(uuid())
  addonName   String
  price       Float
  description String?
  isAvailable Boolean  @default(true)
  maxQuantity Int?     @default(10)
  productId   String
  category    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  product     Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
}

model CustomerLocation {
  id         String   @id @default(uuid())
  userId     String
  address    String
  city       String?
  state      String?
  country    String?
  postalCode String?
  latitude   Float?
  longitude  Float?
  isDefault  Boolean  @default(false)
  label      String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, address])
  @@index([userId])
  @@index([isDefault])
}

model Subcategory {
  id           String    @id @default(uuid())
  name         String
  description  String?
  categoryId   String
  isActive     Boolean   @default(true)
  displayOrder Int       @default(0)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  icon         String?
  image        String?
  products     Product[]
  category     Category  @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([categoryId, name])
  @@index([categoryId])
  @@index([isActive])
}

model Category {
  id            String        @id @default(uuid())
  name          String        @unique
  description   String?
  icon          String?
  image         String?
  isActive      Boolean       @default(true)
  displayOrder  Int           @default(0)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  stores        Store[]
  subcategories Subcategory[]

  @@index([isActive])
}

model Package {
  id          String      @id @default(uuid())
  name        String
  description String?
  type        PackageType
  weight      Float?
  dimensions  Json?
  basePrice   Float
  isActive    Boolean     @default(true)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  storeId     String?
  cartItems   CartItem[]
  orderItems  OrderItem[]
  store       Store?      @relation(fields: [storeId], references: [id])

  @@index([type])
  @@index([isActive])
}

model DeliveryOption {
  id            String   @id @default(uuid())
  name          String
  description   String?
  estimatedDays String?
  baseFee       Float
  perKmFee      Float?
  isActive      Boolean  @default(true)
  displayOrder  Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  orders        Order[]

  @@index([isActive])
}

model ServiceFee {
  id          String          @id @default(uuid())
  name        String
  description String?
  feeType     FeeType
  value       Float
  isActive    Boolean         @default(true)
  appliesTo   FeeApplicableTo
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@index([isActive])
  @@index([appliesTo])
}

model TaxSetting {
  id          String          @id @default(uuid())
  name        String
  description String?
  rate        Float
  isActive    Boolean         @default(true)
  appliesTo   TaxApplicableTo
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@index([isActive])
  @@index([appliesTo])
}

model Cart {
  id           String     @id @default(uuid())
  userId       String?    @unique
  sessionId    String?    @unique
  totalAmount  Float      @default(0)
  expiresAt    DateTime?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  abandonedAt  DateTime?
  checkedOutAt DateTime?
  status       CartStatus @default(ACTIVE)
  user         User?      @relation(fields: [userId], references: [id], onDelete: Cascade)
  items        CartItem[]

  @@index([userId])
  @@index([sessionId])
  @@index([expiresAt])
}

model CartItem {
  id                  String       @id @default(uuid())
  cartId              String
  itemType            CartItemType
  productId           String?
  variantId           String?
  packageId           String?
  selectedAddons      Json?
  quantity            Int
  unitPrice           Float
  totalPrice          Float
  specialInstructions String?
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt
  cart                Cart         @relation(fields: [cartId], references: [id], onDelete: Cascade)
  package             Package?     @relation(fields: [packageId], references: [id])
  product             Product?     @relation(fields: [productId], references: [id])
  variant             Variant?     @relation(fields: [variantId], references: [id])

  @@index([cartId])
  @@index([productId])
  @@index([packageId])
}

model Order {
  id                   String          @id @default(uuid())
  orderNumber          String          @unique
  userId               String
  orderType            OrderType
  subtotal             Float
  deliveryFee          Float
  serviceFee           Float
  taxAmount            Float
  totalAmount          Float
  deliveryOptionId     String?
  dropoffLocation      Json?           @db.Json
  recipientName        String
  recipientPhone       String
  deliveryInstructions String?
  paymentStatus        PaymentStatus   @default(PENDING)
  paymentMethod        PaymentMethod?
  paymentReference     String?         @unique
  monnifyReference     String?         @unique
  orderStatus          OrderStatus     @default(PENDING)
  statusHistory        Json?
  metadata             Json?
  createdAt            DateTime        @default(now())
  updatedAt            DateTime        @updatedAt
  pickupLocation       Json?
  orderCode            String          @unique
  respondedAt          DateTime?
  reason               String?
  canceledAt           DateTime?
  deliveredAt          DateTime?
  driverAssignedAt     DateTime?
  pickedUpAt           DateTime?
  vendorAcceptedAt     DateTime?
  vendorDeclinedAt     DateTime?
  chatMessages         ChatMessage[]
  deliveryOption       DeliveryOption? @relation(fields: [deliveryOptionId], references: [id])
  user                 User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  items                OrderItem[]
  vendorOrderAction    VendorOrderAction?

    orderActivityLogs    OrderActivityLog[]

  driverAssignment     DriverAssignment?

  @@index([orderCode])
  @@index([orderNumber])
  @@index([userId])
  @@index([orderStatus])
  @@index([paymentStatus])
  @@index([createdAt])
}

model OrderItem {
  id                  String       @id @default(uuid())
  orderId             String
  itemType            CartItemType
  productId           String?
  variantId           String?
  storeId             String?
  packageId           String?
  selectedAddons      Json?
  quantity            Int
  unitPrice           Float
  totalPrice          Float
  specialInstructions String?
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt
  order               Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  package             Package?     @relation(fields: [packageId], references: [id])
  product             Product?     @relation(fields: [productId], references: [id])
  store               Store?       @relation(fields: [storeId], references: [id])
  variant             Variant?     @relation(fields: [variantId], references: [id])

  @@index([orderId])
  @@index([productId])
  @@index([storeId])
}

model IdempotencyRecord {
  key       String   @id
  status    String
  orderId   String?  @map("order_id")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("idempotency_records")
}

model StoreDailyCounter {
  storeId    String @map("store_id")
  date       String
  orderCount Int    @default(0) @map("order_count")

  @@id([storeId, date])
  @@map("store_daily_counters")
}

model DriverProfile {
  id                String           @id @default(uuid())
  userId            String           @unique
  address           String?
  city              String?
  state             String?
  country           String?          @default("NG")
  postalCode        String?
  vehicleType       VehicleType      @default(CAR)
  vehicleMake       String?
  vehicleModel      String?
  year              Int?
  licensePlate      String?          @unique
  rating            Float?           @default(0)
  ratingCount       Int?             @default(0)
  totalDeliveries   Int?             @default(0)
  status            DriverStatus     @default(OFFLINE)
  latitude          Float?
  longitude         Float?
  locationUpdatedAt DateTime?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  documents         DriverDocument[]
  user              User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
  @@index([vehicleType])
}

model DriverDocument {
  id              String             @id @default(uuid())
  driverId        String
  documentType    DriverDocumentType
  documentUrl     String
  publicId        String?
  isVerified      Boolean            @default(false)
  createdAt       DateTime           @default(now())
  status          DocumentStatus     @default(PENDING)
  rejectionReason String?
  verifiedAt      DateTime?
  verifiedBy      String?
  driver          DriverProfile      @relation(fields: [driverId], references: [id])

  @@unique([driverId, documentType])
}

model OrderActivityLog {
  id         String       @id @default(uuid())
  orderId    String
  actorId    String? // userId (vendor, driver, customer, system)
  actorRole  Role?
  action     String // ACCEPTED, DECLINED, ASSIGNED, PICKED_UP, DELIVERED, etc.
  fromStatus OrderStatus?
  toStatus   OrderStatus?
  reason     String? // decline reason
  metadata   Json? // extra data like driver location, eta
  createdAt  DateTime     @default(now())
  order      Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([createdAt])
}


model DriverAssignment {
  id                  String   @id @default(uuid())
  orderId             String   @unique
  driverId            String?
  order               Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  assignmentStatus    String?  @default("PENDING")
  assignedAt          DateTime? @db.Timestamp(6)
  etaSeconds          Int?
  pickupConfirmedAt   DateTime? @db.Timestamp(6)
  deliveryConfirmedAt DateTime? @db.Timestamp(6)

  @@index([driverId])
}


model ChatMessage {
  id         String      @id @default(uuid())
  orderId    String
  senderId   String
  senderRole Role
  message    String
  type       MessageType @default(TEXT)
  isRead     Boolean     @default(false)
  readAt     DateTime?
  createdAt  DateTime    @default(now())
  order      Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
}


model Notification {
  id        String           @id @default(uuid())
  userId    String
  type      NotificationType
  title     String
  body      String
  data      Json? // additional payload (orderId, deep link)
  isRead    Boolean          @default(false)
  createdAt DateTime         @default(now())
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
  @@index([createdAt])
}

model VendorOrderAction {
  id          String             @id @default(uuid())
  orderId     String             @unique
  vendorId    String
  status      VendorActionStatus @default(PENDING)
  reason      String?
  respondedAt DateTime?
  order       Order              @relation(fields: [orderId], references: [id])

  @@index([vendorId])
}

enum VendorActionStatus {
  PENDING
  ACCEPTED
  DECLINED
}

enum NotificationType {
  ORDER_STATUS
  VENDOR_ACTION_REQUIRED
  DRIVER_ASSIGNMENT
  PICKUP_ALERT
  RATING_REQUEST
}

enum CartStatus {
  ACTIVE
  CHECKED_OUT
  ABANDONED
}

enum DriverStatus {
  OFFLINE
  ONLINE
  BUSY
  SUSPENDED
  REJECTED
  APPROVED
}

enum DriverDocumentType {
  DRIVER_LICENSE
  VEHICLE_INSURANCE
  VEHICLE_REGISTRATION
}

enum VehicleType {
  CAR
  EV
}

enum Role {
  CUSTOMER
  VENDOR
  DISPATCHER
  ADMIN
  SUPER_ADMIN
}

enum OAuthProviderType {
  GOOGLE
  GITHUB
  FACEBOOK
  APPLE
}

enum DocumentStatus {
  PENDING
  APPROVED
  REJECTED
}

enum UserStatus {
  PENDING_VERIFICATION
  PENDING_EMAIL_VERIFICATION
  PENDING_PHONE_VERIFICATION
  PENDING_ONBOARDING
  PENDING_DOCUMENTS
  READY_FOR_REVIEW
  UNDER_REVIEW
  ACTIVE
  SUSPENDED
  REJECTED
  APPROVED
}

enum OnBoardingStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
}

enum DocumentType {
  CAC
  BUSINESS_PERMIT
  ID_PROOF
}

enum StoreStatus {
  ACTIVE
  INACTIVE
  PENDING_APPROVAL
  SUSPENDED
  REJECTED
}

enum ProductStatus {
  ACTIVE
  INACTIVE
  DRAFT
  OUT_OF_STOCK
}

enum StockStatus {
  IN_STOCK
  OUT_OF_STOCK
  LOW_STOCK
}

enum ProductType {
  SINGLE
  VARIABLE
}

enum DayOfWeek {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
  SUNDAY
}

enum PackageType {
  PACKAGE
  DOCUMENT
}

enum FeeType {
  PERCENTAGE
  FIXED
}

enum FeeApplicableTo {
  ALL
  VENDOR_ORDERS
  PACKAGE_ORDERS
  DOCUMENT_ORDERS
}

enum TaxApplicableTo {
  ALL
  VENDOR_ORDERS
  PACKAGE_ORDERS
  DOCUMENT_ORDERS
}

enum CartItemType {
  PRODUCT
  PACKAGE
  DOCUMENT
}

enum OrderType {
  VENDOR
  PACKAGE
  DOCUMENT
  MIXED
}

enum OrderStatus {
  PENDING
  PROCESSING
  CONFIRMED
  PICKED_UP
  IN_TRANSIT
  DELIVERED
  CANCELLED
  REFUNDED
  ORDER_PLACED
  ORDER_ACCEPTED
  ORDER_ASSIGNED
  ORDER_DECLINED
}

enum PaymentStatus {
  INITIATING
  PENDING
  PAID
  FAILED
  REFUNDED
  PARTIALLY_REFUNDED
}

enum PaymentMethod {
  CARD
  BANK_TRANSFER
  USSD
  QR_CODE
  WALLET
}

enum AssignmentStatus {
  PENDING
  SEARCHING
  ASSIGNED
  REASSIGNING
  ACCEPTED
  REJECTED
  EXPIRED
  FAILED
}

enum MessageType {
  TEXT
  IMAGE
  LOCATION
}

enum VehicleType_new {
  CAR
  EV
}
