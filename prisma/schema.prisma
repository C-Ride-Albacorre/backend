// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  CUSTOMER
  VENDOR
  DISPATCHER
  ADMIN
  SUPER_ADMIN
}

enum OAuthProviderType {
  GOOGLE
  GITHUB
  FACEBOOK
  APPLE
}

enum DocumentStatus {
  PENDING
  APPROVED
  REJECTED
}

enum UserStatus {
  PENDING_VERIFICATION
  PENDING_EMAIL_VERIFICATION
  PENDING_PHONE_VERIFICATION
  PENDING_ONBOARDING
  PENDING_DOCUMENTS
  READY_FOR_REVIEW
  UNDER_REVIEW
  ACTIVE
  APPROVED
  SUSPENDED
  REJECTED
}

enum OnBoardingStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
}

enum DocumentType {
  CAC
  BUSINESS_PERMIT
  ID_PROOF
}

// Enums for various statuses and types
enum StoreStatus {
  ACTIVE
  INACTIVE
  PENDING_APPROVAL
  SUSPENDED
  REJECTED
}

enum ProductStatus {
  ACTIVE
  INACTIVE
  DRAFT
  OUT_OF_STOCK
}

enum StockStatus {
  IN_STOCK
  OUT_OF_STOCK
  LOW_STOCK
}

enum ProductType {
  SINGLE
  VARIABLE
}

enum DayOfWeek {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
  SUNDAY
}

model User {
  id                    String           @id @default(uuid())
  email                 String?          @unique
  phoneNumber           String?          @unique
  password              String?
  firstName             String
  lastName              String
  profilePicture        String?
  role                  Role             @default(CUSTOMER)
  isActive              Boolean          @default(true)
  refreshTokenHash      String?
  referralCode          String?          @unique
  referredBy            String?
  lastLoginAt           DateTime?
  isVerified            Boolean          @default(false)
  verifiedAt            DateTime?
  isEmailVerified       Boolean          @default(false)
  emailVerifiedAt       DateTime?
  isPhoneVerified       Boolean          @default(false)
  phoneVerifiedAt       DateTime?
  onboardingCompletedAt DateTime?
  status                UserStatus       @default(ACTIVE)
  onboardingStatus      OnBoardingStatus @default(NOT_STARTED)
  onboardingStep        Int?
  approvedAt            DateTime?
  approvedBy            String? // User ID of admin who approved
  rejectionReason       String?
  createdAt             DateTime         @default(now())
  updatedAt             DateTime         @updatedAt
  oauthProviders        OAuthProvider[]
  businessInfo          BusinessInfo?
  customerLocations     CustomerLocation[]
  documents             VendorDocument[]
  stores                Store[] // One vendor can have multiple stores
  cart                  Cart[]
  orders                Order[]
  
  @@index([email])
  @@index([phoneNumber])
}

// Update VerificationAttempt model
model VerificationAttempt {
  id            String    @id @default(uuid())
  identifier    String    @unique
  otp           String? // The OTP code
  otpIdentifier String?   @unique // Add this for OTP lookup
  attemptCount  Int       @default(0)
  lastAttemptAt DateTime  @default(now())
  isLocked      Boolean   @default(false)
  lockedUntil   DateTime?
  expiresAt     DateTime
  verified      Boolean   @default(false)
  purpose       String? // registration, password_reset, login, etc.
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([otp])
  @@index([purpose])
  @@index([expiresAt])
}

model OAuthProvider {
  id          String            @id @default(uuid())
  provider    OAuthProviderType //String
  providerId  String
  profileData Json? // Store additional profile data
  userId      String
  user        User              @relation(fields: [userId], references: [id])
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  @@unique([provider, providerId])
  @@unique([userId, provider]) // One provider per user
  @@index([provider, providerId])
}

model BusinessInfo {
  id                 String   @id @default(uuid())
  businessName       String?
  businessType       String?
  description        String?
  businessPhone      String?
  businessEmail      String?
  address            String?
  city               String?
  state              String?
  bankName           String?
  accountNumber      String?
  accountName        String?
  registrationNumber String?
  taxId              String?
  userId             String   @unique
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

model VendorDocument {
  id           String         @id @default(uuid())
  userId       String
  documentType DocumentType   @default(CAC) // Using string for enum, you can define as enum in schema
  documentUrl  String
  status       DocumentStatus @default(PENDING) // PENDING, APPROVED, REJECTED
  metadata     Json?
  uploadedAt   DateTime       @default(now())
  reviewedAt   DateTime?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  user         User           @relation(fields: [userId], references: [id])
}

// Store Model
model Store {
  id                 String             @id @default(uuid())
  storeName          String
  storeCategory      String // Will be populated from admin-provided categories
  storeDescription   String?
  storeAddress       String
  phoneNumber        String
  email              String
  minimumOrder       Float?             @default(0)
  preparationTime    Int? // In minutes
  deliveryFee        Float?
  storeLogo          String? // URL to store logo image
  status             StoreStatus        @default(PENDING_APPROVAL)
  userId             String
  user               User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  operatingHours     OperatingHour[] // Operating Hours (one-to-many relation)
  products           Product[] // Products in this store
  metadata           Json?
  approvedAt         DateTime?
  approvedBy         String? // User ID of admin who approved
  rejectionReason    String?
  storeSubcategories StoreSubcategory[] // Many-to-many with subcategories
  categoryId         String?
  category           Category?          @relation(fields: [categoryId], references: [id])
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  orderItems         OrderItem[]

  @@index([userId])
  @@index([storeCategory])
}

// Operating Hours Model (allows different hours for different days)
model OperatingHour {
  id          String    @id @default(uuid())
  storeId     String
  store       Store     @relation(fields: [storeId], references: [id], onDelete: Cascade)
  dayOfWeek   DayOfWeek // Monday through Sunday
  isOpen      Boolean   @default(true)
  openingTime String? // Format: "09:00"
  closingTime String? // Format: "18:00"
  breakStart  String? // Optional break time
  breakEnd    String? // Optional break time
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([storeId, dayOfWeek])
  @@index([storeId])
}

// Product Model
model Product {
  id                String         @id @default(uuid())
  productName       String
  productCategory   String // Will be populated from admin-provided categories
  sku               String         @unique
  description       String?
  productType       ProductType    @default(SINGLE)
  stockStatus       StockStatus    @default(IN_STOCK)
  productStatus     ProductStatus  @default(DRAFT)
  basePrice         Float? // For SINGLE products, base price
  stockQuantity     Int?           @default(0)
  lowStockThreshold Int?           @default(5) // Alert when stock below this
  productImages     ProductImage[] // Images (one-to-many for multiple product images)
  storeId           String
  store             Store          @relation(fields: [storeId], references: [id], onDelete: Cascade)
  variants          Variant[] // Variants (for VARIABLE products)
  addons            Addon[] // Add-ons (available for all product types)  
  metadata          Json?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
  cartItems         CartItem[]
  orderItems        OrderItem[]

  @@index([storeId])
  @@index([productCategory])
  @@index([sku])
}

// Product Images Model (for multiple images per product)
model ProductImage {
  id           String   @id @default(uuid())
  productId    String
  product      Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  imageUrl     String
  isPrimary    Boolean  @default(false)
  displayOrder Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([productId])
}

// Variant Model (for VARIABLE products)
model Variant {
  id            String      @id @default(uuid())
  variantName   String // e.g., "Small", "Large", "Red", "Blue"
  price         Float
  sku           String      @unique
  stockQuantity Int         @default(0)
  stockStatus   StockStatus @default(IN_STOCK)
  imageUrl      String? // Optional variant-specific image
  productId     String
  product       Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  // Variant attributes (JSON for flexibility)
  attributes    Json? // e.g., { "size": "Large", "color": "Red", "weight": "500g" }
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  cartItems     CartItem[]
  orderItems    OrderItem[]

  @@index([productId])
  @@index([sku])
}

// Addon Model (available for both SINGLE and VARIABLE products)
model Addon {
  id          String   @id @default(uuid())
  addonName   String // e.g., "Extra Cheese", "Gift Wrap"
  price       Float
  description String?
  isAvailable Boolean  @default(true)
  maxQuantity Int?     @default(10) // Maximum allowed per order
  productId   String
  product     Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  // Optional: Addon categories for grouping
  category    String? // e.g., "Toppings", "Extras", "Packaging"
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([productId])
}

// Customer Location
model CustomerLocation {
  id             String   @id @default(uuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  address        String
  city           String?
  state          String?
  country        String?
  postalCode     String?
  latitude       Float?
  longitude      Float?
  isDefault      Boolean  @default(false)
  label          String?  // e.g., "Home", "Office"
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([userId, address])
  @@index([userId])
  @@index([isDefault])
}

// Admin Categories (for future admin management)
model StoreCategory {
  id           String   @id @default(uuid())
  name         String   @unique
  description  String?
  isActive     Boolean  @default(true)
  displayOrder Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([isActive])
}

model ProductCategory {
  id           String   @id @default(uuid())
  name         String   @unique
  description  String?
  isActive     Boolean  @default(true)
  displayOrder Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([isActive])
}

// Add to your schema.prisma

// Store Subcategories (many-to-many relationship)
model StoreSubcategory {
  id            String      @id @default(uuid())
  storeId       String
  store         Store       @relation(fields: [storeId], references: [id], onDelete: Cascade)
  subcategoryId String
  subcategory   Subcategory @relation(fields: [subcategoryId], references: [id], onDelete: Cascade)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@unique([storeId, subcategoryId])
  @@index([storeId])
  @@index([subcategoryId])
}

// Subcategories managed by Admin
model Subcategory {
  id                 String             @id @default(uuid())
  name               String
  description        String?
  categoryId         String
  category           Category           @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  isActive           Boolean            @default(true)
  displayOrder       Int                @default(0)
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  storeSubcategories StoreSubcategory[]

  @@unique([categoryId, name])
  @@index([categoryId])
  @@index([isActive])
}

// Categories managed by Admin
model Category {
  id           String   @id @default(uuid())
  name         String   @unique
  description  String?
  icon         String? // URL to category icon
  image        String? // URL to category image
  isActive     Boolean  @default(true)
  displayOrder Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  subcategories Subcategory[]
  stores        Store[] // Direct relation if needed

  @@index([isActive])
}

// Package/Document Service (separate from vendor stores)
model Package {
  id          String      @id @default(uuid())
  name        String
  description String?
  type        PackageType // PACKAGE or DOCUMENT
  weight      Float? // in kg
  dimensions  Json? // { length, width, height }
  basePrice   Float
  isActive    Boolean     @default(true)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  cartItems   CartItem[]
  orderItems  OrderItem[]

  @@index([type])
  @@index([isActive])
}

enum PackageType {
  PACKAGE
  DOCUMENT
}

// Delivery Options (configured by Admin)
model DeliveryOption {
  id            String   @id @default(uuid())
  name          String // e.g., "Standard Delivery", "Express Delivery", "Same Day"
  description   String?
  estimatedDays String? // e.g., "2-3 business days"
  baseFee       Float
  perKmFee      Float? // Additional fee per km
  isActive      Boolean  @default(true)
  displayOrder  Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  orders        Order[]

  @@index([isActive])
}

// Service Fees (configured by Admin)
model ServiceFee {
  id          String          @id @default(uuid())
  name        String // e.g., "Service Fee", "Platform Fee"
  description String?
  feeType     FeeType // PERCENTAGE or FIXED
  value       Float // Percentage or fixed amount
  isActive    Boolean         @default(true)
  appliesTo   FeeApplicableTo // ALL, VENDOR_ORDERS, PACKAGE_ORDERS, DOCUMENT_ORDERS
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@index([isActive])
  @@index([appliesTo])
}

enum FeeType {
  PERCENTAGE
  FIXED
}

enum FeeApplicableTo {
  ALL
  VENDOR_ORDERS
  PACKAGE_ORDERS
  DOCUMENT_ORDERS
}

// Tax Settings (configured by Admin)
model TaxSetting {
  id          String          @id @default(uuid())
  name        String // e.g., "VAT", "Sales Tax"
  description String?
  rate        Float // Percentage
  isActive    Boolean         @default(true)
  appliesTo   TaxApplicableTo // ALL, VENDOR_ORDERS, PACKAGE_ORDERS, DOCUMENT_ORDERS
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@index([isActive])
  @@index([appliesTo])
}

enum TaxApplicableTo {
  ALL
  VENDOR_ORDERS
  PACKAGE_ORDERS
  DOCUMENT_ORDERS
}

// Cart
model Cart {
  id          String     @id @default(uuid())
  userId      String
  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  sessionId   String? // For guest users
  items       CartItem[]
  totalAmount Float      @default(0)
  expiresAt   DateTime? // Cart expiration
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@unique([userId])
  @@unique([sessionId])
  @@index([userId])
  @@index([sessionId])
  @@index([expiresAt])
}

model CartItem {
  id       String       @id @default(uuid())
  cartId   String
  cart     Cart         @relation(fields: [cartId], references: [id], onDelete: Cascade)
  itemType CartItemType // PRODUCT, PACKAGE, DOCUMENT

  // For product items
  productId String?
  product   Product? @relation(fields: [productId], references: [id])
  variantId String?
  variant   Variant? @relation(fields: [variantId], references: [id])

  // For package/document items
  packageId String?
  package   Package? @relation(fields: [packageId], references: [id])

  // Selected add-ons (for products)
  selectedAddons Json? // Array of addon IDs with quantities

  quantity            Int
  unitPrice           Float
  totalPrice          Float
  specialInstructions String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@index([cartId])
  @@index([productId])
  @@index([packageId])
}

enum CartItemType {
  PRODUCT
  PACKAGE
  DOCUMENT
}

// Orders
model Order {
  id          String @id @default(uuid())
  orderNumber String @unique
  userId      String
  user        User   @relation(fields: [userId], references: [id])

  // Order details
  items     OrderItem[]
  orderType OrderType // VENDOR, PACKAGE, DOCUMENT, MIXED

  // Pricing
  subtotal    Float
  deliveryFee Float
  serviceFee  Float
  taxAmount   Float
  totalAmount Float

  // Delivery
  deliveryOptionId     String?
  deliveryOption       DeliveryOption? @relation(fields: [deliveryOptionId], references: [id])
  pickupLocation       String? // For vendor orders (store address)
  dropoffLocation      String
  recipientName        String
  recipientPhone       String
  deliveryInstructions String?

  // Payment
  paymentStatus    PaymentStatus  @default(PENDING)
  paymentMethod    PaymentMethod?
  paymentReference String?        @unique
  monnifyReference String?        @unique

  // Status
  orderStatus   OrderStatus @default(PENDING)
  statusHistory Json? // Track status changes

  // Metadata
  metadata  Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([orderNumber])
  @@index([userId])
  @@index([orderStatus])
  @@index([paymentStatus])
  @@index([createdAt])
}

model OrderItem {
  id       String       @id @default(uuid())
  orderId  String
  order    Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  itemType CartItemType

  // For product items
  productId String?
  product   Product? @relation(fields: [productId], references: [id])
  variantId String?
  variant   Variant? @relation(fields: [variantId], references: [id])
  storeId   String?
  store     Store?   @relation(fields: [storeId], references: [id])

  // For package/document items
  packageId String?
  package   Package? @relation(fields: [packageId], references: [id])

  // Selected add-ons
  selectedAddons Json? // Array of { addonId, name, price, quantity }

  // Pricing
  quantity            Int
  unitPrice           Float
  totalPrice          Float
  specialInstructions String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([orderId])
  @@index([productId])
  @@index([storeId])
}

enum OrderType {
  VENDOR // Only vendor products
  PACKAGE // Only packages
  DOCUMENT // Only documents
  MIXED // Mix of different types
}

enum OrderStatus {
  PENDING
  PROCESSING
  CONFIRMED
  PICKED_UP
  IN_TRANSIT
  DELIVERED
  CANCELLED
  REFUNDED
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
  PARTIALLY_REFUNDED
}

enum PaymentMethod {
  CARD
  BANK_TRANSFER
  USSD
  QR_CODE
  WALLET
}
